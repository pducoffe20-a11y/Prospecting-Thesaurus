{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A B2B prospect or sales lead with contact info and AI intelligence fields.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "Qualified", "ClosedWon", "ClosedLost"] },
        "score": { "type": "number" },
        "notes": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "aiEmail": { "type": "string" },
        "aiAnalysis": { "type": "string" }
      },
      "required": ["name", "company", "status", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Sales leads managed by specific users."
    }
  }
}
